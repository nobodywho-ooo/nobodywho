+    // loader returns are the ICD's own objects, whose first member is the
+    // ICD's dispatch table, so they dispatch like any cl_khr_icd platform.
+    // Enumerate through clGetPlatformIDs and let the per-platform checks
+    // below (dispatchable, CL_PLATFORM_ICD_SUFFIX_KHR) accept or reject them.
+    if (!p_clIcdGetPlatformIDs)
+    {
+        p_clIcdGetPlatformIDs = (pfn_clIcdGetPlatformIDs)(size_t)khrIcdOsLibraryGetFunctionAddress(library, "clGetPlatformIDs");
+        if (p_clIcdGetPlatformIDs)
+        {
+            KHR_ICD_TRACE("%s does not implement clIcdGetPlatformIDsKHR, treating it as an ICD loader and enumerating through clGetPlatformIDs\n", libraryName);
+        }
+    }
+#endif
