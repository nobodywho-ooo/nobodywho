if(NOT PROJECT_NAME STREQUAL "llama.cpp")
  return()
endif()

set(LLAMA_OPENSSL OFF CACHE BOOL "" FORCE)

if(GGML_CPU_ALL_VARIANTS AND GGML_CPU_ARM_ARCH)
  set(GGML_CPU_ARM_ARCH "" CACHE STRING "" FORCE)
endif()

