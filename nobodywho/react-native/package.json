{
  "name": "react-native-nobodywho",
  "version": "5.1.0",
  "description": "Run LLMs locally and offline with React Native & Expo - Tool calling, RAG, Speech-to-Text, Text-to-Speech, and VAD",
  "main": "src/wrapper.ts",
  "types": "src/wrapper.ts",
  "exports": {
    ".": "./src/wrapper.ts"
  },
  "license": "EUPL-1.2",
  "homepage": "https://www.nobodywho.ai",
  "bugs": "https://github.com/nobodywho-ooo/nobodywho/issues",
  "keywords": [
    "react-native",
    "expo",
    "ai",
    "llm",
    "local-ai",
    "inference",
    "stt",
    "tts",
    "vad",
    "gguf",
    "on-device",
    "offline"
  ],
  "files": [
    "src/",
    "generated/",
    "cpp/",
    "ios/",
    "android/",
    "Nobodywho.podspec",
    "ubrn.config.yaml",
    "!android/build",
    "!android/.cxx",
    "!android/src/main/jniLibs"
  ],
  "codegenConfig": {
    "name": "NobodywhoSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "ooo.nobodywho"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nobodywho-ooo/nobodywho.git"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-6",
    "uniffi-bindgen-react-native": "0.31.0-6"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "prettier": "^3.9.9"
  }
}
