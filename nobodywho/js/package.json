{
  "name": "react-native-nobodywho",
  "version": "6.0.0",
  "author": "NobodyWho <info@nobodywho.ooo>",
  "description": "Run LLMs locally and offline with React Native & Expo - Tool calling, RAG, Speech-to-Text, Text-to-Speech, and VAD",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "type": "module",
  "license": "EUPL-1.2",
  "homepage": "https://www.nobodywho.ai",
  "bugs": "https://github.com/nobodywho-ooo/nobodywho/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nobodywho-ooo/nobodywho.git",
    "directory": "nobodywho/js"
  },
  "keywords": [
    "react-native",
    "expo",
    "ai",
    "llm",
    "local-ai",
    "inference",
    "stt",
    "tts",
    "vad",
    "gguf",
    "on-device",
    "offline"
  ],
  "files": [
    "src/",
    "cpp/",
    "ios/",
    "android/",
    "Nobodywho.podspec",
    "ubrn.config.yaml",
    "!android/build",
    "!android/.cxx",
    "!android/src/main/jniLibs"
  ],
  "scripts": {
    "ios": "uniffi-bindgen-react-native build ios",
    "android": "uniffi-bindgen-react-native build android",
    "generate-turbo-module": "uniffi-bindgen-react-native generate jsi turbo-module nobodywho",
    "test": "node --test",
    "generate-bindings": "cd ../uniffi && uniffi-bindgen-react-native generate jsi bindings --library --ts-dir ../js/src/generated/jsi --cpp-dir ../js/cpp/generated"
  },
  "codegenConfig": {
    "name": "NobodywhoSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "ooo.nobodywho"
    }
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-6",
    "uniffi-bindgen-react-native": "0.31.0-6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "react": "^19.2.3",
    "react-native": "^0.84.1",
    "prettier": "^3.9.10"
  }
}
