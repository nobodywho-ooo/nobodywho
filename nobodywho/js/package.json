{
  "name": "react-native-nobodywho",
  "version": "5.1.0",
  "author": "NobodyWho <info@nobodywho.ooo>",
  "description": "Run LLMs locally and offline with React Native & Expo - Tool calling, RAG, Speech-to-Text, Text-to-Speech, and VAD",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/todo.web.js",
  "exports": {
    ".": {
      "node": "./dist/todo.node.js",
      "browser": "./dist/todo.web.js",
      "react-native": "./dist/todo.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "EUPL-1.2",
  "homepage": "https://www.nobodywho.ai",
  "bugs": "https://github.com/nobodywho-ooo/nobodywho/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nobodywho-ooo/nobodywho.git",
    "directory": "nobodywho/js"
  },
  "keywords": [
    "react-native",
    "expo",
    "ai",
    "llm",
    "local-ai",
    "inference",
    "stt",
    "tts",
    "vad",
    "gguf",
    "llama.cpp",
    "on-device",
    "offline",
    "web",
    "wasm"
  ],
  "files": [
    "dist/",
    "src/",
    "!src/uniffi.wasm",
    "generated/",
    "cpp/",
    "ios/",
    "android/",
    "Nobodywho.podspec",
    "ubrn.config.yaml",
    "!android/build",
    "!android/.cxx",
    "!android/src/main/jniLibs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "test": "npm run build && node --test __tests__/",
    "prepack": "npm run typecheck && npm run build",
    "ios": "uniffi-bindgen-react-native build ios",
    "android": "uniffi-bindgen-react-native build android",
    "build-uniffi": "cargo +nightly rustc -Zbuild-std -pnobodywho-uniffi --target wasm32-unknown-emscripten --lib",
    "generate-turbo-module": "uniffi-bindgen-react-native generate jsi turbo-module nobodywho",
    "generate-jsi-bindings": "cd ../uniffi && uniffi-bindgen-react-native generate jsi bindings --library --ts-dir ../js/generated/ts --cpp-dir ../js/generated/cpp",
    "generate-wasm-bindings": "cd ../uniffi && uniffi-bindgen-react-native generate wasm2 bindings --library --ts-dir ../js/generated/wasm"
  },
  "codegenConfig": {
    "name": "NobodywhoSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "ooo.nobodywho"
    }
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-6",
    "@ubjs/wasm": "^0.31.0-6",
    "uniffi-bindgen-react-native": "0.31.0-6"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "react": "^19.2.3",
    "react-native": "^0.84.1",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3"
  }
}
