{
  "name": "nobodywho",
  "version": "5.1.0",
  "author": "NobodyWho <info@nobodywho.ooo>",
  "description": "Run LLMs locally and offline with React Native & Expo - Tool calling, RAG, Speech-to-Text, Text-to-Speech, and VAD",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=22"
  },
  "license": "EUPL-1.2",
  "homepage": "https://www.nobodywho.ai",
  "bugs": "https://github.com/nobodywho-ooo/nobodywho/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nobodywho-ooo/nobodywho.git",
    "directory": "nobodywho/js/wasm"
  },
  "keywords": [
    "wasm",
    "ai",
    "llm",
    "local-ai",
    "inference",
    "stt",
    "tts",
    "vad",
    "gguf",
    "on-device",
    "offline",
    "llama.cpp"
  ],
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "test": "npm run build && node --test __tests__/",
    "prepack": "npm run typecheck && npm run build",
    "build-uniffi": "cargo +nightly rustc -Zbuild-std -pnobodywho-uniffi --target wasm32-unknown-emscripten --lib",
    "generate-bindings": "cd ../../uniffi && uniffi-bindgen-react-native generate wasm2 bindings --library --ts-dir ../js/wasm/src/generated"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-6",
    "@ubjs/wasm": "^0.31.0-6",
    "uniffi-bindgen-react-native": "0.31.0-6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3"
  }
}
