{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Runs in both Node.js and the browser; only pull in Node's types explicitly.
    "types": ["node"],

    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    // `tsdown` does the emitting, `tsc` only typechecks.
    "noEmit": true
  },
  "include": ["src", "tsdown.config.ts"]
}
