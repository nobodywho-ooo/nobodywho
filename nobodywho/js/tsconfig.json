{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Runs in React Native, browsers and Node.js; only pull in Node's types explicitly.
    "types": ["node"],

    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    // `tsdown` does the emitting, `tsc` only typechecks.
    "noEmit": true
  },
  "include": ["src", "tsdown.config.mts"],
  // Generated by uniffi-bindgen-react-native, uses JSX syntax for no reason.
  "exclude": ["src/index.tsx"]
}
